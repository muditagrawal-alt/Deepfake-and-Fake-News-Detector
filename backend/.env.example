# Copy to repo-root/.env (or backend/.env). Never commit the real file.

# ── Required for the default hosted analysis engine ──────────────────────
GEMINI_API_KEY=            # https://aistudio.google.com/app/apikey

# ── Optional integrations ───────────────────────────────────────────────
GROQ_API_KEY=              # sampled-video speech transcription: https://console.groq.com/keys

# ── OPTIONAL fallbacks ──────────────────────────────────────────────────
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
HF_TOKEN=

# ── Account API authentication and encrypted BYOK storage ─────────────────
# Must match BACKEND_TOKEN_SECRET in frontend/.env.local.
BACKEND_TOKEN_SECRET=
# Generate: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BYOK_ENCRYPTION_KEY=
# Defaults to a local SQLite file. Use a durable PostgreSQL URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/veritas

# ── Non-secret knobs (defaults shown; override as needed) ───────────────
# GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# GEMINI_SECONDARY_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=10
# GEMINI_DAILY_QUOTA=400
# VIDEO_STRATEGY=native              # or "frames" (sampled frames + optional Groq Whisper)
# IMAGE_GROUNDING=true
# ENABLE_ONNX_DETECTOR=false   # true adds the pixel detector (~500 MB resident)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
# RATE_LIMIT_PER_IP=10/hour
# MAX_IMAGE_MB=10
# MAX_IMAGE_PIXELS=40000000
# MAX_VIDEO_MB=50
# MAX_VIDEO_SECONDS=90
