# Backend base URL (no trailing slash). Set to your HF Space URL on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:7860

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Must match BACKEND_TOKEN_SECRET in backend/.env. Generate once and copy to both.
BACKEND_TOKEN_SECRET=

# OAuth app credentials. GitHub is the recommended sign-in option.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
