{
  "info": {
    "_postman_id": "veritas-api-v2-collection",
    "name": "Veritas API - Comprehensive Test Suite",
    "description": "Production Postman test collection for Veritas Fake Content & Deepfake Detector API.\nIncludes whitebox validation, authentication flows, and high-traffic telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dynamically generate a valid HMAC-SHA256 bearer token for authenticated requests",
          "function base64url(str) {",
          "    return CryptoJS.enc.Base64.stringify(str)",
          "        .replace(/=+$/, '')",
          "        .replace(/\\+/g, '-')",
          "        .replace(/\\//g, '_');",
          "}",
          "",
          "const secret = pm.environment.get('secret') || '0123456789abcdef0123456789abcdef0123456789abcdef';",
          "const sub = pm.environment.get('user_sub') || 'a'.repeat(64);",
          "const email = pm.environment.get('user_email') || 'tester@veritas.test';",
          "const now = Math.floor(Date.now() / 1000);",
          "",
          "const header = { alg: 'HS256', typ: 'JWT' };",
          "const payload = {",
          "    iss: 'veritas-web',",
          "    aud: 'veritas-api',",
          "    sub: sub,",
          "    auth_iat: now * 1000,",
          "    email: email,",
          "    name: 'Postman Runner',",
          "    picture: '',",
          "    iat: now,",
          "    exp: now + 300",
          "};",
          "",
          "const encodedHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "const encodedPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "const signatureInput = `${encodedHeader}.${encodedPayload}`;",
          "const signature = base64url(CryptoJS.HmacSHA256(signatureInput, secret));",
          "",
          "const jwt = `${signatureInput}.${signature}`;",
          "pm.variables.set('bearer_token', jwt);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. System & Telemetry",
      "item": [
        {
          "name": "GET / (Service Discovery Card)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is service card JSON', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.service).to.eql('Veritas API');",
                  "    pm.expect(json.endpoints).to.be.an('array');",
                  "});",
                  "pm.test('Latency is under 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
